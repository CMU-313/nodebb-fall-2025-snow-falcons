[Unit]
Description=NodeBB Translator Service
After=network.target

[Service]
Type=simple
User=team25
WorkingDirectory=/home/team25/nodebb-fall-2025-snow-falcons
Environment="TRANSLATOR_PORT=5000"
Environment="OLLAMA_HOST=http://localhost:11434"
Environment="OLLAMA_MODEL=qwen3:0.6b"
ExecStart=/usr/bin/python3 translator_service.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target


